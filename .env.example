# ── Database (Supabase Postgres) ──────────────────────────────
# Runtime: Supabase transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Development/CI only: an empty scratch database used by `npm run db:check`. Its contents are wiped. Never point it at real data.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/cyon_shadow"

# ── Supabase Storage (server-side only; never expose the service role key) ──
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROOFS_BUCKET="payment-proofs"
SUPABASE_BACKUPS_BUCKET="backups"

# ── App ──────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
ORG_NAME="CYON"
# Random string protecting /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=""

# ── First Super Admin ────────────────────────────────────────
# Created by `npm run db:bootstrap` (runs on every Vercel build) only while no active
# Super Admin exists; ignored afterwards. Give an email, a phone, or both.
# The password must be changed at first sign-in; you can then delete SUPER_ADMIN_PASSWORD.
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_PASSWORD=""

# ── Member logins ────────────────────────────────────────────
# Every new member login starts with this password and must change it at first sign-in.
# At least 8 characters with letters and a number.
MEMBER_DEFAULT_PASSWORD=""
